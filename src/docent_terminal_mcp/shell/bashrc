# rcfile for docent-terminal-mcp's bash sessions.
#
# bash reads this instead of its usual startup files, so first do what a
# login shell would -- tmux panes normally run one -- so the user's
# environment, prompt and aliases are the same as in any other pane.

if [ -f /etc/profile ]; then
    . /etc/profile
fi
if [ -f ~/.bash_profile ]; then
    . ~/.bash_profile
elif [ -f ~/.bash_login ]; then
    . ~/.bash_login
elif [ -f ~/.profile ]; then
    . ~/.profile
elif [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# The session's own commands (`docent-terminal-mcp ssh`, ...) come first on PATH.
case ":$PATH:" in *":$__DTMCP_BIN:"*) ;; *) [ -n "$__DTMCP_BIN" ] && PATH="$__DTMCP_BIN:$PATH" ;; esac

. "${BASH_SOURCE[0]%/*}/integration.bash"
